{
  "title": "DSAForge Monitoring",
  "uid": "dsaforge-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Nginx Exporter Up",
      "type": "stat",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "nginx_up", "legendFormat": "Nginx up"}
      ]
    },
    {
      "id": 2,
      "title": "HTTP Requests",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "nginx_http_requests_total", "legendFormat": "HTTP requests"}
      ]
    }
  ]
}